# =============================================================================
# Stora Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Server ----
PORT=9421
HOST=0.0.0.0
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DEBUG=false
TIME_ZONE=Asia/Shanghai
TITLE=Stora
DOMAIN=http://localhost:9421

# ---- Reverse proxy ----
# Header carrying the real client IP (used for rate limiting, audit logs and IP
# allow-lists). Leave empty unless a reverse proxy overwrites it itself, e.g. X-Real-IP.
TRUSTED_IP_HEADER=

# ---- CORS ----
# Comma-separated origins allowed to call the API from a browser (defaults to DOMAIN).
# Never use "*" together with cookie authentication.
CORS_ALLOWED_ORIGINS=

# ---- Auth cookie ----
# Mark the access_token cookie Secure (HTTPS only). Keep true in production;
# browsers still accept Secure cookies on localhost.
COOKIE_SECURE=true

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stora
# prefer | require | verify-ca | verify-full. Use require (or better) in production.
DB_SSLMODE=prefer

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_EXPIRATION_DELTA=7200        # Access token TTL (seconds, default 2h)
REFRESH_TOKEN_EXPIRATION_DELTA=64800  # Refresh token TTL (seconds, default 18h)

# ---- Storage ----
STORAGE_DRIVER=local             # local or s3
STORAGE_OBJECTS_DIR=storage/objects  # Content-addressed objects root (git-style)
TEMP_FOLDER=temp/upload          # Temp directory for chunked upload assembly

# ---- S3-compatible object storage (only if STORAGE_DRIVER=s3) ----
# MinIO is NOT supported (archived / AGPL-only). Recommended: RustFS (Apache-2.0, S3-compatible).
# Also works with Ceph RGW, AWS S3, Aliyun OSS, etc. — any S3-compatible endpoint.
# Create the bucket yourself first; Stora never auto-creates it.
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=stora
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Non-AWS endpoints almost always need path-style addressing.
S3_FORCE_PATH_STYLE=true
# Presigned download URLs let browsers fetch directly from object storage, but
# bypass application-level audit. Keep false unless you accept that trade-off.
S3_PRESIGN_DOWNLOAD=false

# ---- Email / SMTP (for notifications & verification codes) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stora.local

# ---- Vault / Encryption ----
# Vault 加密密钥（AES-256-GCM）。留空则使用 SECRET_KEY 派生。
# 建议设置独立的密钥，避免 SECRET_KEY 泄露影响 Vault 数据安全。
VAULT_ENCRYPTION_KEY=

# ---- Speed Limits (KB/s, 0 = unlimited) ----
UPLOAD_SPEED_LIMIT=0
DOWNLOAD_SPEED_LIMIT=0
